## 🔐 .ENV ПЕРЕМЕННЫЕ

```bash
# Telegram
BOT_TOKEN=                      # Токен бота
ADMIN_IDS=                      # ID админов через запятую

# PostgreSQL
DATABASE_PATH=                  # asyncpg://user:pass@host/db
DATABASE_URL=                   # То же самое

# Redis
REDIS_URL=                      # redis://localhost:6379/0

# OpenRouter (текст)
OPENROUTER_API_KEY=             # sk-or-...

# VseGPT (изображения/видео) и ProxyAPI (Health)
OPENAI_API_KEY=                 # API ключ

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=       # Логин магазина
ROBOKASSA_PASSWORD1=            # Пароль 1
ROBOKASSA_PASSWORD2=            # Пароль 2
ROBOKASSA_TEST_MODE=1           # 1=тест, 0=боевой
```

